{
  "name": "google-mcp",
  "version": "0.1.0",
  "description": "MCP server for Google services (Analytics Admin + Data API to start)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "start": "node dist/index.js",
    "login": "node dist/index.js login",
    "status": "node dist/index.js status"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@googleapis/analyticsadmin": "^22.0.1",
    "@googleapis/analyticsdata": "^10.1.1",
    "@googleapis/searchconsole": "^11.0.1",
    "@googleapis/siteverification": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
